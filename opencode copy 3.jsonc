{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "ableton-full": {
      "type": "local",
      "command": [".venv/Scripts/python", "ableton_full_mcp_server.py"],
      "enabled": true,
    },
    "surge-osc": {
      "type": "local",
      "command": [".venv/Scripts/python", "surge_osc_mcp.py"],
      "enabled": true,
    },
    "AbletonMCP-extended": {
      "type": "local",
      "command": [".venv/Scripts/python", "ableton-mcp-extended/MCP_Server/server.py"],
      "enabled": true,
    }
  },
    "experimental": {
    "mcp_timeout": 600000
  }
}