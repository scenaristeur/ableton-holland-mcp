{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "timeout": {
      "startup": 180000,
      "catalog": 60000,
      "execution": 600000
    },
    "servers": {
      "ableton-full": {
        "type": "local",
        "command": [".venv/Scripts/python", "ableton_full_mcp_server.py"],
        "timeout": { "startup": 180000, "catalog": 60000, "execution": 600000 }
      },
      "surge-osc": {
        "type": "local",
        "command": [".venv/Scripts/python", "surge_osc_mcp.py"],
        "timeout": { "startup": 180000, "catalog": 60000, "execution": 600000 }
      }
    }
  }
}
