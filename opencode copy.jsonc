{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "ableton-mcp": {
      "type": "local",
      "command": ["uvx", "ableton-mcp"],
      "enabled": true,
    },
    "music-analysis": {
      "type": "local",
      "command": [".venv/Scripts/python", "music_analysis_plus.py"],
      "enabled": true,
    },
      "experimental": {
    "mcp_timeout": 600000
  }
  },
}