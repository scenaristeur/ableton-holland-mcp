{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "ableton-mcp": {
      "type": "local",
      // Or ["bun", "x", "my-mcp-command"]
      "command": ["uvx", "ableton-mcp"],
      "enabled": true,
    },
    "music-analysis": {
      "command": "uvx",
      "args": ["-n", "mcp-music-analysis"]
    }
  },
}